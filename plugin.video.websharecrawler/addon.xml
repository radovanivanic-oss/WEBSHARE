<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon
  id="plugin.video.websharecrawler"
  name="Webshare Atlas"
  version="0.8.0"
  provider-name="Radeco">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="sk_SK">Webshare Atlas mediálny katalóg.</summary>
    <description lang="sk_SK">Stránkovaný Webshare mediálny katalóg s premiérovými novinkami, live metadata proxy a resolverom až pri kliknutí.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
