{
  "name": "webshare-crawler",
  "version": "1.0.0",
  "description": "Webshare video crawler for Ubuntu cron and Kodi JSON export",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node main.js",
    "check": "node --check main.js && node --check lib/maintenance-cycle.js && node --check lib/production-maintenance.js && node --check lib/series-identity.js && node --check scripts/maintenance-cycle.js && node --check scripts/run-production-maintenance.js && node --check scripts/reconcile-series-identities.js && node --check lib/stale-verification.js && node --check scripts/stale-verification.js && node --check lib/stale-cleanup.js && node --check scripts/stale-cleanup.js && node --check lib/weekly-stale-maintenance.js && node --check scripts/run-weekly-stale-maintenance.js && node --check scripts/stale-schedule.js",
    "check:publish": "node --check publish-exports.js",
    "catalog:export": "node main.js --classify-only",
    "catalog:import": "node scripts/import-catalog-jsonl.js",
    "catalog:reclassify": "node scripts/reclassify-catalog.js",
    "catalog:update-db": "node scripts/update-catalog-database.js",
    "catalog:create-manifest": "node scripts/create-catalog-manifest.js",
    "db:migrate": "node scripts/migrate-catalog.js",
    "db:backup": "node scripts/backup-catalog.js",
    "media:audit": "node scripts/audit-media-entity-resolution.js",
    "media:apply": "node scripts/apply-media-entity-resolution.js",
    "media:classify-unclassified:audit": "node scripts/audit-unclassified-classification.js",
    "media:classify-unclassified:deep-audit": "node scripts/audit-unclassified-classification-v2.js",
    "metadata:enrichment:audit": "node scripts/audit-unclassified-metadata-enrichment.js",
    "metadata:classified-backfill:audit": "node scripts/audit-classified-metadata-backfill.js",
    "metadata:classified-backfill:apply": "node scripts/apply-classified-metadata-backfill.js",
    "media:display-titles:audit": "node scripts/audit-display-titles.js",
    "media:purge-unclassified:plan": "node scripts/plan-unclassified-purge.js",
    "media:purge-unclassified:apply": "node scripts/apply-unclassified-purge.js",
    "db:compact": "node scripts/compact-catalog.js",
    "public-catalog:build": "node scripts/build-public-catalog.js",
    "public-catalog:validate": "node scripts/validate-public-catalog.js",
    "metadata:enrich": "node scripts/enrich-metadata.js",
    "maintenance:daily": "node scripts/run-daily-maintenance.js --mode daily-best-effort",
    "maintenance:weekly": "node scripts/run-daily-maintenance.js --mode weekly-stale",
    "observation:daily": "node scripts/run-daily-discovery-observation.js",
    "observation:analyze": "node scripts/analyze-daily-observation-series.js",
    "audit:anonymous-search": "node scripts/b50-audit-anonymous-search.js",
    "enumeration:compare": "node scripts/compare-enumeration-snapshot.js",
    "enumeration:benchmark": "node scripts/benchmark-enumeration-only.js",
    "provenance:daily-candidates:audit": "node scripts/audit-daily-candidate-provenance.js",
    "api:start": "node server/catalog-api.js",
    "publish:github": "node publish-exports.js",
    "test": "node --test tests/*.test.js",
    "persistence:report": "node scripts/report-persistence-eligibility.js",
    "persistence:apply": "node scripts/apply-persistence-plan.js",
    "maintenance:cycle": "node scripts/maintenance-cycle.js",
    "maintenance:prepare": "node scripts/maintenance-cycle.js prepare",
    "maintenance:status": "node scripts/maintenance-cycle.js status",
    "maintenance:authorize-apply": "node scripts/maintenance-cycle.js authorize-apply",
    "maintenance:apply": "node scripts/maintenance-cycle.js apply",
    "maintenance:prepare-publication": "node scripts/maintenance-cycle.js prepare-publication",
    "maintenance:authorize-publication": "node scripts/maintenance-cycle.js authorize-publication",
    "maintenance:publish": "node scripts/maintenance-cycle.js publish",
    "maintenance:production": "node scripts/run-production-maintenance.js",
    "maintenance:demo": "node scripts/maintenance-cycle.js demo",
    "stale:run": "node scripts/stale-verification.js run",
    "stale:status": "node scripts/stale-verification.js status",
    "stale:cleanup": "node scripts/stale-cleanup.js",
    "stale:weekly": "node scripts/run-weekly-stale-maintenance.js",
    "stale:schedule:install": "node scripts/stale-schedule.js install",
    "stale:schedule:status": "node scripts/stale-schedule.js status",
    "stale:schedule:remove": "node scripts/stale-schedule.js remove",
    "stale:demo": "node scripts/stale-verification.js demo",
    "kodi:build": "node scripts/publish-kodi-repository.js build",
    "kodi:publish": "node scripts/publish-kodi-repository.js publish"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0",
    "xml2js": "^0.6.2"
  },
  "keywords": [],
