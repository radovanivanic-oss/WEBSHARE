WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
# Optional local-only legacy utility credentials. Never commit values.
PROXY_API_KEY=
WEBSHARE_WST=
OUTPUT_JSON_PATH=/var/www/html/videos_all.json

CATALOG_DB_PATH=/home/radeco/webshare-crawler/data/catalog.sqlite
CATALOG_API_HOST=127.0.0.1
CATALOG_API_PORT=8787
CATALOG_API_BASE_PATH=/api
CATALOG_IMPORT_BATCH_SIZE=1000
CATALOG_API_MAX_PAGE_SIZE=100
CATALOG_RETAIN_JSONL=true
# Fail-closed guardrail. Ponechaj false, kým samostatná validácia nepotvrdí úplný crawl.
CATALOG_ALLOW_FULL_RECONCILIATION=false
# Webshare search reports a capped total but exposes additional offset pages.
# The server wrapper enables this bounded best-effort discovery automatically;
# it never marks the catalogue complete without a provider completeness proof.
CRAWLER_BEST_EFFORT_SEARCH=true
CRAWLER_MAX_PAGES_PER_PREFIX=110
# Retry transiently failed prefixes once after each normal crawl.
CRAWLER_RETRY_FAILED_ONCE=true

TMDB_API_KEY=
MAINTENANCE_PUBLICATION_ADAPTER=lib/maintenance-publication-adapter.js
TMDB_LANGUAGE=sk-SK
TMDB_FALLBACK_LANGUAGES=cs-CZ,en-US
TMDB_MAX_CONCURRENCY=2
TMDB_REQUEST_DELAY_MS=300
TMDB_CACHE_TTL_DAYS=30
TMDB_LIVE_REQUEST_TIMEOUT_MS=2500
TMDB_LIVE_TOTAL_TIMEOUT_MS=5000
TMDB_LIVE_CACHE_TTL_HOURS=6
TMDB_LIVE_STALE_TTL_HOURS=168
TMDB_LIVE_ERROR_TTL_MINUTES=5
TMDB_LIVE_RATE_LIMIT_PER_MINUTE=30
METADATA_ENRICH_BATCH_SIZE=500
METADATA_AUTO_MATCH_THRESHOLD=0.90
METADATA_AMBIGUOUS_THRESHOLD=0.72
