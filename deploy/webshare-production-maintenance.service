[Unit]
Description=Webshare Atlas daily production maintenance
After=network-online.target webshare-daily-observation.service
Wants=network-online.target

[Service]
Type=oneshot
User=radeco
Group=radeco
WorkingDirectory=/home/radeco/webshare-crawler
EnvironmentFile=-/home/radeco/webshare-crawler/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=MAINTENANCE_PUBLICATION_ADAPTER=/home/radeco/webshare-crawler/lib/maintenance-publication-adapter.js
Environment=PRODUCTION_MAINTENANCE_LOG=/home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log
ExecStart=/usr/bin/env node scripts/run-production-maintenance.js
StandardOutput=append:/home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log
StandardError=append:/home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

