# The host cron daemon runs in UTC and does not reliably honor CRON_TZ for
# per-entry scheduling. These seasonal UTC entries run only when the
# Europe/Bratislava wall clock is exactly 03:47. A privileged deployment may
# replace them with webshare-production-maintenance.timer.
17 */6 * * * cd /home/radeco/webshare-crawler && /usr/bin/env METADATA_ENRICH_BATCH_SIZE=500 METADATA_ENRICH_MAX_ATTEMPTS=3 /bin/bash scripts/run-metadata-enrichment.sh >> /home/radeco/webshare-crawler/runtime/metadata-enrichment.log 2>&1
47 1 * 3-10 * TZ=Europe/Bratislava /bin/sh -c '[ "$(date +\%H:\%M\ \%z)" = "03:47 +0200" ] && cd /home/radeco/webshare-crawler && env NODE_OPTIONS=--max-old-space-size=8192 MAINTENANCE_PUBLICATION_ADAPTER=/home/radeco/webshare-crawler/lib/maintenance-publication-adapter.js PRODUCTION_MAINTENANCE_LOG=/home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log /usr/bin/node scripts/run-production-maintenance.js >> /home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log 2>&1'
47 2 * 11-12,1-2 * TZ=Europe/Bratislava /bin/sh -c '[ "$(date +\%H:\%M\ \%z)" = "03:47 +0100" ] && cd /home/radeco/webshare-crawler && env NODE_OPTIONS=--max-old-space-size=8192 MAINTENANCE_PUBLICATION_ADAPTER=/home/radeco/webshare-crawler/lib/maintenance-publication-adapter.js PRODUCTION_MAINTENANCE_LOG=/home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log /usr/bin/node scripts/run-production-maintenance.js >> /home/radeco/webshare-crawler/runtime/production-maintenance/production-cron.log 2>&1'
